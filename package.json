{
  "name": "@neongate-ai/orbz-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Technical documentation for @neongate-ai/orbz.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "24.x"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NeonGate-AI/docs.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "postbuild": "pagefind --site .next/server/app --output-path public/_pagefind",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check": "pnpm format:check && biome lint . && pnpm typecheck && pnpm build",
    "format:check": "biome format .",
    "neon": "neon"
  },
  "dependencies": {
    "@neongate-ai/orbz": "0.3.1",
    "next": "16.3.1",
    "nextra": "4.6.1",
    "nextra-theme-docs": "4.6.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "next-themes": "0.4.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@neongate-ai/neon": "0.1.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "pagefind": "1.5.2",
    "typescript": "5.9.3"
  }
}
