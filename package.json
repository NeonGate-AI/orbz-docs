{
  "name": "@neongate-ai/orbz-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Technical documentation for @neongate-ai/orbz.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "24.x"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NeonGate-AI/docs.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "postbuild": "pagefind --site .next/server/app --output-path public/_pagefind",
    "start": "next start",
    "harness": "npx harness-score",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "harness:check": "sh .audits/architecture.audit.sh && sh .audits/rules.audit.sh && sh .audits/specs.audit.sh && sh .audits/workflow-skills.audit.sh && sh .audits/content.audit.sh && sh .audits/accessibility.audit.sh && sh .audits/web-quality.audit.sh && sh .audits/performance.audit.sh && sh .audits/security.audit.sh && sh .audits/git-workflow.audit.sh",
    "check:static": "pnpm format:check && pnpm lint && pnpm typecheck",
    "check": "pnpm harness:check && pnpm check:static && pnpm build",
    "commitlint": "commitlint",
    "precommit": "lint-staged",
    "prepare": "husky",
    "lockfile:refresh": "pnpm install --lockfile-only --ignore-scripts",
    "security:audit": "pnpm audit --prod --audit-level=high"
  },
  "dependencies": {
    "@neongate-ai/orbz": "1.0.0",
    "next": "16.3.4",
    "nextra": "4.6.1",
    "nextra-theme-docs": "4.6.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "next-themes": "0.4.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@neongate-ai/neon": "0.1.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "pagefind": "1.5.2",
    "typescript": "5.9.3"
  }
}
